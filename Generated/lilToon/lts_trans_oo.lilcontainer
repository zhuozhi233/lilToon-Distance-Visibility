Shader "DistanceVisibility/lilToon/[Optional] OutlineOnly/Transparent"
{
    Properties
    {
        lilProperties "Default"
        lilProperties "DefaultTransparent"
            lilProperties "lilCustomShaderProperties.lilblock"
    }

    lilPassShaderName "Hidden/DistanceVisibility/lilToon/ltspass_transparent"
    lilSubShaderTags {"RenderType" = "TransparentCutout" "Queue" = "AlphaTest+10"}
    lilSubShaderBRP "DefaultUsePassOutlineOnly"
    lilSubShaderLWRP "DefaultUsePassOutlineOnly"
    lilSubShaderURP "DefaultUsePassOutlineOnly"
    lilSubShaderHDRP "DefaultUsePassOutlineOnly"

    CustomEditor "*LIL_EDITOR_NAME*"
}